# Copy this file to .env and fill in your API key(s).
# This file is committed as a template; the real .env is git-ignored.

# Your OpenAI API key (or an OpenAI-compatible endpoint key)
OPENAI_API_KEY=sk-your-key-here

# Optional: override the base URL for OpenAI-compatible services
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the model used for extraction and scoring
# OPENAI_MODEL=gpt-4o-mini
